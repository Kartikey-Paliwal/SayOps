# Copy to .env (git-ignored) and fill in.
GROQ_API_KEY=...                       # console.groq.com → API Keys
LLM_MODEL=openai/gpt-oss-120b
DATABASE_URL=postgres://...            # Neon
GITHUB_TOKEN=...                       # fine-grained: actions:write on proof repo
PROOF_REPO=owner/sayops-proof-runner
PROOF_CALLBACK_SECRET=...
DEMO_MODE=true
DEMO_DAILY_LLM_BUDGET=200
DEMO_DAILY_PROOF_RUNS=60
RATE_LIMIT_PER_MIN=30
